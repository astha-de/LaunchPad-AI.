# GEMINI_API_KEY: Required for server-side Gemini AI calls (Resume Analyzer, JD Matcher, Interview Prep).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# MONGODB_URI: Required MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/launchpad_ai?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/launchpad_ai?retryWrites=true&w=majority"

# JWT_SECRET: Secret key used to sign and verify JWT authentication tokens (use a long random string in production).
JWT_SECRET="replace-with-a-strong-random-secret"

# PORT: Server port (AI Studio uses 3000).
PORT=3000

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"
